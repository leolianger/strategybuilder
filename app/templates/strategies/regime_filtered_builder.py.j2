from freqtrade.strategy import IStrategy
from pandas import DataFrame
import talib.abstract as ta

class {{ strategy_name }}(IStrategy):
    timeframe = "{{ timeframe }}"
    minimal_roi = {"0": {{ minimal_roi }}}
    stoploss = {{ stoploss }}
{{ common_class_block|indent(4, true) }}

    def populate_indicators(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        dataframe["rsi"] = ta.RSI(dataframe, timeperiod={{ rsi_period }})
        dataframe["ema_fast"] = ta.EMA(dataframe, timeperiod={{ ema_fast }})
        dataframe["ema_slow"] = ta.EMA(dataframe, timeperiod={{ ema_slow }})
        dataframe["channel_high"] = dataframe["high"].rolling({{ channel_window }}).max().shift(1)
        dataframe["channel_low"] = dataframe["low"].rolling({{ channel_window }}).min().shift(1)
{% if regime_filter == "ema200_uptrend" %}
        dataframe["regime"] = ta.EMA(dataframe, timeperiod=200)
{% elif regime_filter == "adx_strength" %}
        dataframe["regime"] = ta.ADX(dataframe, timeperiod={{ adx_period }})
{% else %}
        dataframe["atr_pct"] = ta.ATR(dataframe, timeperiod={{ atr_period }}) / dataframe["close"]
{% endif %}
        return dataframe

    def populate_entry_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
{% if base_logic == "rsi_reversion" %}
        base_cond = dataframe["rsi"] < {{ rsi_entry }}
{% elif base_logic == "ema_trend" %}
        base_cond = dataframe["ema_fast"] > dataframe["ema_slow"]
{% else %}
        base_cond = dataframe["close"] > dataframe["channel_high"]
{% endif %}
{% if regime_filter == "ema200_uptrend" %}
        regime_cond = dataframe["close"] > dataframe["regime"]
{% elif regime_filter == "adx_strength" %}
        regime_cond = dataframe["regime"] > {{ adx_threshold }}
{% else %}
        regime_cond = dataframe["atr_pct"] < {{ max_atr_pct }} / 100.0
{% endif %}
        dataframe.loc[base_cond & regime_cond, "enter_long"] = 1
        return dataframe

    def populate_exit_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
{% if base_logic == "rsi_reversion" %}
        exit_cond = dataframe["rsi"] > {{ rsi_exit }}
{% elif base_logic == "ema_trend" %}
        exit_cond = dataframe["ema_fast"] < dataframe["ema_slow"]
{% else %}
        exit_cond = dataframe["close"] < dataframe["channel_low"]
{% endif %}
        dataframe.loc[exit_cond, "exit_long"] = 1
        return dataframe
