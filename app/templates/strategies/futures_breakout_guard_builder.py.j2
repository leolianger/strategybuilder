from freqtrade.strategy import IStrategy
from pandas import DataFrame
import talib.abstract as ta


class {{ strategy_name }}(IStrategy):
    timeframe = "{{ timeframe }}"
    minimal_roi = {"0": {{ minimal_roi }} }
    stoploss = {{ stoploss }}
{% if trade_direction == "long_only" %}
    can_short = False
{% else %}
    can_short = True
{% endif %}
{{ common_class_block|indent(4, true) }}

    def populate_indicators(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        dataframe["channel_high"] = dataframe["high"].rolling({{ breakout_window }}).max().shift(1)
        dataframe["channel_low"] = dataframe["low"].rolling({{ breakout_window }}).min().shift(1)
        dataframe["exit_high"] = dataframe["high"].rolling({{ exit_window }}).max().shift(1)
        dataframe["exit_low"] = dataframe["low"].rolling({{ exit_window }}).min().shift(1)
        dataframe["adx"] = ta.ADX(dataframe, timeperiod={{ adx_period }})
        dataframe["volume_ma"] = dataframe["volume"].rolling({{ volume_period }}).mean()
        dataframe["atr"] = ta.ATR(dataframe, timeperiod={{ atr_period }})
        dataframe["atr_pct"] = dataframe["atr"] / dataframe["close"] * 100.0
        return dataframe

    def populate_entry_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        strength_gate = dataframe["adx"] >= {{ adx_min }}
        volume_gate = dataframe["volume"] >= dataframe["volume_ma"] * {{ volume_multiplier }}
        volatility_gate = dataframe["atr_pct"] <= {{ max_atr_pct }}
        buffer = {{ breakout_buffer_pct }} / 100.0
{% if trade_direction in ["long_only", "long_short"] %}
        long_breakout = dataframe["close"] > dataframe["channel_high"] * (1.0 + buffer)
        dataframe.loc[long_breakout & strength_gate & volume_gate & volatility_gate & dataframe["channel_high"].notna(), "enter_long"] = 1
{% endif %}
{% if trade_direction in ["short_only", "long_short"] %}
        short_breakout = dataframe["close"] < dataframe["channel_low"] * (1.0 - buffer)
        dataframe.loc[short_breakout & strength_gate & volume_gate & volatility_gate & dataframe["channel_low"].notna(), "enter_short"] = 1
{% endif %}
        return dataframe

    def populate_exit_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        volatility_exit = dataframe["atr_pct"] > {{ hard_atr_pct }}
{% if trade_direction in ["long_only", "long_short"] %}
        long_exit = (dataframe["close"] < dataframe["exit_low"]) | volatility_exit
        dataframe.loc[long_exit & dataframe["exit_low"].notna(), "exit_long"] = 1
{% endif %}
{% if trade_direction in ["short_only", "long_short"] %}
        short_exit = (dataframe["close"] > dataframe["exit_high"]) | volatility_exit
        dataframe.loc[short_exit & dataframe["exit_high"].notna(), "exit_short"] = 1
{% endif %}
        return dataframe
