from freqtrade.strategy import IStrategy
from pandas import DataFrame
import talib.abstract as ta


class {{ strategy_name }}(IStrategy):
    timeframe = "{{ timeframe }}"
    minimal_roi = {"0": {{ minimal_roi }} }
    stoploss = {{ stoploss }}
{{ common_class_block|indent(4, true) }}

    def populate_indicators(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        if "reference_close" in dataframe.columns:
            dataframe["reference_proxy"] = dataframe["reference_close"]
        else:
            dataframe["reference_proxy"] = ta.EMA(dataframe, timeperiod={{ reference_ema }})
        dataframe["spread"] = dataframe["close"] - dataframe["reference_proxy"]
        dataframe["spread_mean"] = dataframe["spread"].rolling({{ spread_window }}).mean()
        dataframe["spread_std"] = dataframe["spread"].rolling({{ spread_window }}).std()
        dataframe["spread_z"] = (dataframe["spread"] - dataframe["spread_mean"]) / dataframe["spread_std"].replace(0, 1)
        dataframe["trend_guard"] = ta.EMA(dataframe, timeperiod={{ trend_guard_ema }})
        dataframe["atr"] = ta.ATR(dataframe, timeperiod={{ atr_period }})
        dataframe["atr_pct"] = dataframe["atr"] / dataframe["close"] * 100.0
        dataframe["volume_ma"] = dataframe["volume"].rolling({{ volume_period }}).mean()
        return dataframe

    def populate_entry_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        entry = (
            (dataframe["spread_z"] <= -{{ entry_z }}) &
            (dataframe["close"] >= dataframe["trend_guard"] * (1 - {{ max_below_trend_pct }} / 100.0)) &
            (dataframe["atr_pct"] <= {{ max_atr_pct }}) &
            (dataframe["volume"] >= dataframe["volume_ma"] * {{ volume_multiplier }})
        )
        dataframe.loc[entry & dataframe["spread_z"].notna(), "enter_long"] = 1
        return dataframe

    def populate_exit_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        exit_condition = (
            (dataframe["spread_z"] >= {{ exit_z }}) |
            (dataframe["spread_z"] <= -{{ hard_z }}) |
            (dataframe["atr_pct"] >= {{ hard_atr_pct }})
        )
        dataframe.loc[exit_condition & dataframe["spread_z"].notna(), "exit_long"] = 1
        return dataframe
