from freqtrade.strategy import IStrategy
from pandas import DataFrame
import talib.abstract as ta

class {{ strategy_name }}(IStrategy):
    timeframe = "{{ timeframe }}"
    minimal_roi = {"0": {{ minimal_roi }}}
    stoploss = {{ stoploss }}
{{ common_class_block|indent(4, true) }}

    def populate_indicators(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        dataframe["atr_pct"] = ta.ATR(dataframe, timeperiod={{ atr_period }}) / dataframe["close"]
        dataframe["ema_fast"] = ta.EMA(dataframe, timeperiod={{ ema_fast }})
        dataframe["ema_slow"] = ta.EMA(dataframe, timeperiod={{ ema_slow }})
        dataframe["rsi"] = ta.RSI(dataframe, timeperiod={{ rsi_period }})
        dataframe["channel_high_fast"] = dataframe["high"].rolling({{ fast_breakout_window }}).max().shift(1)
        dataframe["channel_high_slow"] = dataframe["high"].rolling({{ slow_breakout_window }}).max().shift(1)
        dataframe["channel_low"] = dataframe["low"].rolling({{ exit_window }}).min().shift(1)
        dataframe["volume_ma"] = dataframe["volume"].rolling({{ volume_period }}).mean()
        return dataframe

    def populate_entry_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        low_vol = dataframe["atr_pct"] < {{ low_vol_atr_pct }} / 100.0
        high_vol = dataframe["atr_pct"] > {{ high_vol_atr_pct }} / 100.0
        normal_vol = ~(low_vol | high_vol)

        trend_ok = dataframe["ema_fast"] > dataframe["ema_slow"]
        low_vol_entry = low_vol & (dataframe["close"] > dataframe["channel_high_fast"])
        normal_vol_entry = normal_vol & trend_ok & (dataframe["rsi"] > {{ rsi_momentum_min }})
{% if allow_high_vol_entries %}
        high_vol_entry = high_vol & trend_ok & (dataframe["volume"] > dataframe["volume_ma"] * {{ high_vol_volume_mult }})
{% else %}
        high_vol_entry = False
{% endif %}
        dataframe.loc[low_vol_entry | normal_vol_entry | high_vol_entry, "enter_long"] = 1
        return dataframe

    def populate_exit_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        exit_cond = (dataframe["close"] < dataframe["channel_low"]) | (dataframe["ema_fast"] < dataframe["ema_slow"]) | (dataframe["rsi"] < {{ rsi_exit_min }})
        dataframe.loc[exit_cond, "exit_long"] = 1
        return dataframe
