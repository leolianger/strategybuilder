from freqtrade.strategy import IStrategy
from pandas import DataFrame
import talib.abstract as ta

class {{ strategy_name }}(IStrategy):
    timeframe = "{{ timeframe }}"
    minimal_roi = {"0": {{ minimal_roi }} }
    stoploss = {{ stoploss }}
{{ common_class_block|indent(4, true) }}

    def populate_indicators(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        dataframe["ema_fast"] = ta.EMA(dataframe, timeperiod={{ ema_fast }})
        dataframe["ema_slow"] = ta.EMA(dataframe, timeperiod={{ ema_slow }})
        dataframe["quality_ema"] = ta.EMA(dataframe, timeperiod={{ quality_ema }})
        dataframe["exit_ema"] = ta.EMA(dataframe, timeperiod={{ exit_ema }})
        dataframe["rsi"] = ta.RSI(dataframe, timeperiod={{ rsi_period }})
        dataframe["adx"] = ta.ADX(dataframe, timeperiod={{ adx_period }})
        dataframe["atr"] = ta.ATR(dataframe, timeperiod={{ atr_period }})
        dataframe["atr_pct"] = dataframe["atr"] / dataframe["close"] * 100.0
        dataframe["volume_ma"] = dataframe["volume"].rolling({{ volume_period }}).mean()
        dataframe["body_pct"] = (dataframe["close"] - dataframe["open"]).abs() / dataframe["close"] * 100.0
        dataframe["distance_pct"] = (dataframe["close"] - dataframe["quality_ema"]).abs() / dataframe["close"] * 100.0
        dataframe["channel_high"] = dataframe["high"].rolling({{ breakout_window }}).max().shift(1)
        dataframe["channel_low"] = dataframe["low"].rolling({{ exit_window }}).min().shift(1)
        return dataframe

    def populate_entry_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
{% if trigger_signal == "breakout" %}
        trigger = dataframe["close"] > dataframe["channel_high"]
{% elif trigger_signal == "rsi_recovery" %}
        trigger = (dataframe["rsi"] >= {{ rsi_recovery_min }}) & (dataframe["ema_fast"] > dataframe["ema_slow"])
{% else %}
        trigger = dataframe["ema_fast"] > dataframe["ema_slow"]
{% endif %}
        quality_score = 0
{% if use_volume_gate %}
        quality_score = quality_score + (dataframe["volume"] >= dataframe["volume_ma"] * {{ min_volume_ratio }}).astype(int)
{% endif %}
{% if use_volatility_gate %}
        quality_score = quality_score + (dataframe["atr_pct"] <= {{ max_atr_pct }}).astype(int)
{% endif %}
{% if use_distance_gate %}
        quality_score = quality_score + (dataframe["distance_pct"] <= {{ max_distance_pct }}).astype(int)
{% endif %}
{% if use_candle_gate %}
        quality_score = quality_score + (dataframe["body_pct"] <= {{ max_body_pct }}).astype(int)
{% endif %}
{% if use_strength_gate %}
        quality_score = quality_score + (dataframe["adx"] >= {{ adx_min }}).astype(int)
{% endif %}
        not_overheated = dataframe["rsi"] <= {{ rsi_overheat_max }}
        dataframe.loc[trigger & not_overheated & (quality_score >= {{ min_quality_score }}) & dataframe["ema_slow"].notna(), "enter_long"] = 1
        return dataframe

    def populate_exit_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        exit_condition = (
            (dataframe["close"] < dataframe["exit_ema"]) |
            (dataframe["close"] < dataframe["channel_low"]) |
            (dataframe["atr_pct"] > {{ hard_atr_pct }}) |
            (dataframe["rsi"] < {{ rsi_exit_floor }})
        )
        dataframe.loc[exit_condition & dataframe["ema_slow"].notna(), "exit_long"] = 1
        return dataframe
