from freqtrade.strategy import IStrategy
from pandas import DataFrame
import talib.abstract as ta

class {{ strategy_name }}(IStrategy):
    timeframe = "{{ timeframe }}"
    minimal_roi = {"0": {{ minimal_roi }} }
    stoploss = {{ stoploss }}
{{ common_class_block|indent(4, true) }}

    def populate_indicators(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        dataframe["ema_fast"] = ta.EMA(dataframe, timeperiod={{ ema_fast }})
        dataframe["ema_slow"] = ta.EMA(dataframe, timeperiod={{ ema_slow }})
        dataframe["macro_ema"] = ta.EMA(dataframe, timeperiod={{ macro_ema }})
        dataframe["exit_ema"] = ta.EMA(dataframe, timeperiod={{ exit_ema }})
        dataframe["rsi"] = ta.RSI(dataframe, timeperiod={{ rsi_period }})
        dataframe["adx"] = ta.ADX(dataframe, timeperiod={{ adx_period }})
        dataframe["atr"] = ta.ATR(dataframe, timeperiod={{ atr_period }})
        dataframe["atr_pct"] = dataframe["atr"] / dataframe["close"] * 100.0
        dataframe["volume_ma"] = dataframe["volume"].rolling({{ volume_period }}).mean()
        dataframe["channel_high"] = dataframe["high"].rolling({{ breakout_window }}).max().shift(1)
        dataframe["channel_low"] = dataframe["low"].rolling({{ exit_window }}).min().shift(1)
        return dataframe

    def populate_entry_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        base_signal = dataframe["ema_fast"] > dataframe["ema_slow"]
        if "{{ base_signal }}" == "breakout":
            base_signal = dataframe["close"] > dataframe["channel_high"]
        elif "{{ base_signal }}" == "recovery":
            base_signal = (dataframe["rsi"] >= {{ rsi_recovery_min }}) & (dataframe["close"] > dataframe["ema_slow"])

        trend_regime = (dataframe["close"] > dataframe["macro_ema"]) & (dataframe["adx"] >= {{ trend_adx_min }})
        high_vol_regime = dataframe["atr_pct"] >= {{ high_vol_atr_pct }}
        low_vol_regime = dataframe["atr_pct"] <= {{ low_vol_atr_pct }}

        trend_confirmation = (dataframe["rsi"] >= {{ rsi_recovery_min }}) & (dataframe["volume"] >= dataframe["volume_ma"] * {{ volume_multiplier }})
        high_vol_confirmation = (dataframe["volume"] >= dataframe["volume_ma"] * {{ high_vol_volume_multiplier }}) & (dataframe["rsi"] <= {{ rsi_overheat_max }})
        low_vol_confirmation = (dataframe["close"] > dataframe["ema_fast"]) | (dataframe["close"] > dataframe["channel_high"])
        default_confirmation = (dataframe["rsi"] >= {{ rsi_recovery_min }}) & (dataframe["rsi"] <= {{ rsi_overheat_max }})

        routed_confirmation = (
            (trend_regime & trend_confirmation) |
            (high_vol_regime & high_vol_confirmation) |
            (low_vol_regime & low_vol_confirmation) |
            (~trend_regime & ~high_vol_regime & ~low_vol_regime & default_confirmation)
        )
{% if router_strictness == "strict" %}
        routed_confirmation = routed_confirmation & (dataframe["volume"] >= dataframe["volume_ma"] * {{ volume_multiplier }})
{% elif router_strictness == "volatility_first" %}
        routed_confirmation = routed_confirmation & (dataframe["atr_pct"] <= {{ hard_atr_pct }})
{% endif %}
        dataframe.loc[base_signal & routed_confirmation & dataframe["ema_slow"].notna(), "enter_long"] = 1
        return dataframe

    def populate_exit_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        exit_condition = (
            (dataframe["close"] < dataframe["exit_ema"]) |
            (dataframe["close"] < dataframe["channel_low"]) |
            (dataframe["atr_pct"] > {{ hard_atr_pct }}) |
            (dataframe["rsi"] < {{ rsi_exit_floor }})
        )
        dataframe.loc[exit_condition & dataframe["ema_slow"].notna(), "exit_long"] = 1
        return dataframe
