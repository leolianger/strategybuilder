from freqtrade.strategy import IStrategy
from pandas import DataFrame
import talib.abstract as ta

class {{ strategy_name }}(IStrategy):
    timeframe = "{{ timeframe }}"
    minimal_roi = {"0": {{ minimal_roi }} }
    stoploss = {{ stoploss }}
{{ common_class_block|indent(4, true) }}

    def populate_indicators(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        dataframe["ema_fast"] = ta.EMA(dataframe, timeperiod={{ ema_fast }})
        dataframe["ema_slow"] = ta.EMA(dataframe, timeperiod={{ ema_slow }})
        dataframe["rsi"] = ta.RSI(dataframe, timeperiod={{ rsi_period }})
        dataframe["adx"] = ta.ADX(dataframe, timeperiod={{ adx_period }})
        dataframe["atr"] = ta.ATR(dataframe, timeperiod={{ atr_period }})
        dataframe["atr_pct"] = dataframe["atr"] / dataframe["close"] * 100.0
        dataframe["volume_ma"] = dataframe["volume"].rolling({{ volume_period }}).mean()
        dataframe["candle_range_pct"] = (dataframe["high"] - dataframe["low"]) / dataframe["close"] * 100.0
        dataframe["body_pct"] = (dataframe["close"] - dataframe["open"]).abs() / dataframe["close"] * 100.0
        dataframe["distance_pct"] = (dataframe["close"] - dataframe["ema_slow"]).abs() / dataframe["close"] * 100.0
        return dataframe

    def populate_entry_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        trend_ok = dataframe["ema_fast"] > dataframe["ema_slow"]
        momentum_ok = dataframe["rsi"] >= {{ rsi_recovery_min }}
        volume_ok = dataframe["volume"] >= dataframe["volume_ma"] * {{ min_volume_ratio }}
        candle_ok = dataframe["candle_range_pct"] <= {{ max_candle_range_pct }}
        body_ok = dataframe["body_pct"] <= {{ max_body_pct }}
        distance_ok = dataframe["distance_pct"] <= {{ max_distance_pct }}
        volatility_ok = dataframe["atr_pct"] <= {{ max_entry_atr_pct }}
        strength_ok = dataframe["adx"] >= {{ adx_min }}
{% if guard_mode == "strict" %}
        entry_condition = trend_ok & momentum_ok & volume_ok & candle_ok & body_ok & distance_ok & volatility_ok & strength_ok
{% elif guard_mode == "liquidity_first" %}
        entry_condition = trend_ok & momentum_ok & volume_ok & candle_ok & volatility_ok
{% else %}
        entry_condition = trend_ok & momentum_ok & volume_ok & volatility_ok
{% endif %}
        dataframe.loc[entry_condition & dataframe["volume_ma"].notna(), "enter_long"] = 1
        return dataframe

    def populate_exit_trend(self, dataframe: DataFrame, metadata: dict) -> DataFrame:
        exit_condition = (dataframe["ema_fast"] < dataframe["ema_slow"]) | (dataframe["rsi"] <= {{ rsi_exit_floor }}) | (dataframe["atr_pct"] >= {{ hard_atr_pct }})
        dataframe.loc[exit_condition & dataframe["volume_ma"].notna(), "exit_long"] = 1
        return dataframe
